# ── RGM node — .gitignore ───────────────────────────────────────────
# Автотулы / сборка (стандарт для дерева Bitcoin Core)
*.o
*.a
*.lo
*.la
*.so
*.dll
*.exe
.deps/
.libs/
.dirstamp
autom4te.cache/
config.log
config.status
configure
configure~
aclocal.m4
libtool
Makefile
Makefile.in
src/config/bitcoin-config.h*
src/config/stamp-h1
build-aux/
libbitcoinconsensus.pc

# Логи сборки и отладки (наши)
*.log
rgm-log.txt

# Артефакты аудита и рабочие файлы — НЕ для публики
rgm-pq*.tar.gz
rgm-pq.diff
rgm-pq-grep.txt

# Готовые бинарники — распространяются через Releases, не через git
release/
depends/built/
depends/work/
depends/sources/
depends/x86_64*/
depends/i686*/

# Данные и конфиги нод — секреты!
*.conf
!contrib/**/*.conf
wallet.dat
peers.dat
banlist.dat
.rgm*/

# Девлоги и отчёты (содержат пароли и внутренности инфраструктуры)
*devlog*
*session_report*

# Редакторы / ОС
*.swp
*~
.vscode/
.idea/
Thumbs.db
.DS_Store
share/setup.nsi
